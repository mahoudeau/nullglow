# Nullglow for zsh. Generated by build.py. Don't edit it.
#
# Add ONE line to the end of your ~/.zshrc, after compinit and after the zsh
# plugins load:
#
#   source ~/.config/nullglow/theme.zsh
#
# That's the whole install. This file owns bat, LS_COLORS, fzf, syntax
# highlighting, autosuggestions, the completion menu and history search.
# Switching variants is re-running install.sh, not editing your rc.

# ── bat, and delta through it ────────────────────────────────────────────────
export BAT_THEME="Nullglow"

# ── ls, eza and fd, through LS_COLORS ────────────────────────────────────────
if command -v vivid >/dev/null 2>&1; then
  export LS_COLORS="$(vivid generate nullglow)"
fi

# ── fzf. Appended, so options you set earlier survive ────────────────────────
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} \
  --color=bg+:#0e1512,bg:-1,spinner:#2bf59b,hl:#ff4d9e \
  --color=fg:#cfd8d3,header:#ff4d9e,info:#d79bff,pointer:#2bf59b \
  --color=marker:#2bf59b,fg+:#cfd8d3,prompt:#2bf59b,hl+:#ff4d9e \
  --color=border:#1c2723"

# ── zsh-syntax-highlighting ──────────────────────────────────────────────────
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#2bf59b'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#2bf59b'
ZSH_HIGHLIGHT_STYLES[function]='fg=#2bf59b'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#2bf59b'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#2bf59b,italic'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ff5c5c,bold'
ZSH_HIGHLIGHT_STYLES[path]='fg=#48b8f5,underline'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#f5d76b'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#f5d76b'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#6e7d71,italic'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#d79bff'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#ff4d9e'

# ── zsh-autosuggestions ──────────────────────────────────────────────────────
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6e7d71'

# ── completion menu ──────────────────────────────────────────────────────────
# This one has to live here, not in your rc. It expands $LS_COLORS at the point
# it's called, so it has to run after the export above, not before it.
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{#d79bff}%B%d%b%f'
zstyle ':completion:*:messages'     format '%F{#48b8f5}%d%f'
zstyle ':completion:*:warnings'     format '%F{#ff4d9e}no match%f'
zstyle ':completion:*:corrections'  format '%F{#f5d76b}%d (errors: %e)%f'

# ── history-substring-search ─────────────────────────────────────────────────
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=#1c2723,fg=#f5d76b,bold'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg=#ff5c5c,bold'
